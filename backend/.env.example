# PostgreSQL ulanish manzili
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://oquv_user:oquv_pass_change_me@localhost:5432/oquv_markaz

# JWT token imzolash uchun maxfiy kalit - bu qatorni albatta o'zgartiring!
# Masalan generatsiya qilish uchun: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Token necha soatdan keyin eskiradi
JWT_EXPIRE_HOURS=12

# Birinchi marta ishga tushirilganda avtomatik yaratiladigan foydalanuvchilar
# Bazada hech qanday user bo'lmasa shu qiymatlar bilan yaratiladi
INITIAL_RAHBAR_USERNAME=rahbar
INITIAL_RAHBAR_PASSWORD=rahbar123
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_SECRET_PASSWORD=maxfiy2026

# Frontend qaysi manzillardan so'rov yuborishiga ruxsat berish (CORS)
# Bir nechtasini vergul bilan ajrating
CORS_ORIGINS=http://localhost:5500,http://localhost:8080,https://oxmed.uz
